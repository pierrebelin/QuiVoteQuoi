DATABASE_URL=postgresql://hemicycle:mot_de_passe@127.0.0.1:5432/hemicycle?sslmode=disable

# Fournisseur utilisé par les deux traitements LLM (thématisation et synthèses).
# Valeurs : anthropic, openai ou mistral. Absent : anthropic, pour compatibilité.
LLM_PROVIDER=anthropic

# Une seule de ces clés est utilisée, selon LLM_PROVIDER. Toutes peuvent
# rester présentes dans le fichier pour basculer sans modifier le code.
# Sans clé du fournisseur choisi, le reste du site tourne (RM-01).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèles propres à chaque fournisseur. Le modèle du fournisseur choisi est
# utilisé si THEME_MODEL ou DOSSIER_SUMMARY_MODEL n'est pas renseigné.
# ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5.6-luna
# Absent : mistral-small-latest. Préférer un identifiant daté : l'alias
# `-latest` change de modèle sans prévenir, et le modèle enregistré avec chaque
# proposition ne permettrait plus de savoir lequel a répondu.
# MISTRAL_MODEL=mistral-small-latest

# Surcharges facultatives par usage, pour garder un modèle différent selon le
# traitement. Elles doivent correspondre au fournisseur sélectionné.
# THEME_MODEL=claude-opus-5

# Modele de la synthese automatique des actes par groupe. Absent :
# le modèle du fournisseur sélectionné. Cette synthese ne produit aucun chiffre.
# DOSSIER_SUMMARY_MODEL=claude-opus-5

# Modèle de « En bref » (une ligne par article d'un texte de loi). Absent : le
# modèle du fournisseur sélectionné. Les lignes enregistrent ce modèle et la
# version du prompt ; les chiffres sont contrôlés par le code, pas par le modèle.
# TEXT_BRIEF_MODEL=claude-opus-5

# Objets soumis au rattachement thématique à chaque rafraîchissement. Plafond,
# pas objectif : le reliquat est repris au rafraîchissement suivant, et un
# objet déjà rattaché n'est jamais resoumis (RM-14). Absent : 100. `0` suspend
# la catégorisation sans toucher au reste du rafraîchissement.
THEME_BATCH_PER_REFRESH=100

# Amendements ecrits a chaque rafraichissement. Meme regle : un plafond, pas un
# objectif, le reliquat est repris a la passe suivante. La legislature en compte
# plusieurs centaines de milliers et le timer d'ingestion passe toutes les deux
# heures : sans borne, une passe deborderait la fenetre. `0` leve la borne, pour
# un premier chargement lance a la main hors cadence.
AMENDMENT_BATCH_PER_REFRESH=40000

# Dossiers dont les syntheses sont examinees apres chaque rafraichissement.
# Plafond mecanique : les dossiers restants sont repris a la passe suivante.
DOSSIER_SUMMARY_BATCH_PER_REFRESH=10

# Dossiers votés dont les textes (versions déposées ou adoptées, « En bref »)
# sont lus à chaque rafraîchissement, au vote le plus récent d'abord. Plafond,
# pas objectif : chaque version lue est un téléchargement du texte intégral (le
# projet de loi de finances pèse plusieurs mégaoctets), le reliquat est repris à
# la passe suivante. Absent : 5. Borné à 1..50.
TEXT_BRIEF_DOSSIERS_PER_REFRESH=5

# Identifiants PISTE (Légifrance), pour lire la rédaction en vigueur des articles
# de code et de loi que cite un article « En bref » (RM-07). À demander sur
# https://piste.gouv.fr (application OAuth « client credentials »). Sans l'un
# des deux, le reste du site tourne : les articles qui citent un article de code
# ou de loi restent en attente (RM-08).
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
# `true` vise l'environnement d'essai de PISTE (identifiants du bac à sable).
LEGIFRANCE_SANDBOX=false

# Secret maître des routes d'écriture. Le jeton présenté par le front admin et
# par le CRON n'est pas cette valeur : il en est dérivé, jour par jour
# (src/infrastructure/security.rs). Le jeton du jour s'obtient avec
# `deploy/bin/admin-token.sh`.
#
# Générer :  openssl rand -hex 32
# Absent, ou plus court que 32 caractères : toutes les routes d'écriture
# répondent 403. Le changer révoque immédiatement tous les jetons en circulation.
ADMIN_TOKEN_SECRET=remplacer-par-openssl-rand-hex-32

# Adresse d'écoute. La boucle locale par défaut : en production Nginx est le
# seul client du backend. `0.0.0.0` seulement dans un conteneur.
BIND_ADDR=127.0.0.1
PORT=3000

# Origines tierces autorisées à lire l'API, séparées par des virgules. Vide =
# aucune : le front est servi par le même hôte en production, et par le proxy
# Vite en développement.
ALLOWED_ORIGINS=

RUST_LOG=info
